# 必要な環境変数の一覧。値は書かない（このファイルはリポジトリに入る）。
#
# 実際の値を書く場所は2か所ある。
#   手元で動かす用 : scraper/.env      … gitignore 済み。持ち出されない
#   本番            : GitHub Secrets    … Actions から読まれる。登録後は読み出せない
#                     https://github.com/diawork2000-tech/wuthering-trends-web/settings/secrets/actions
#
# 本番で動くのは GitHub Actions 側だけなので、手元の .env は
# 動作確認をするときにだけ要る。


# ---- 収集 (scraper/) ----

# YouTube Data API v3。複数ある場合はカンマ区切りで並べる。
# 前から順に使い、1日の上限(1キー10,000単位)に当たったら次へ自動で切り替わる。
#   例: YOUTUBE_API_KEY=AIzaXXXX,AIzaYYYY
YOUTUBE_API_KEY=

# 公式SNS（X・BiliBili・Weibo）の投稿を読むための中継サーバー。
# RSSHub を自前で立てて、その URL を入れる。
#   例: RSSHUB_BASE_URL=https://rsshub-production-xxxx.up.railway.app
# 公開インスタンス(rsshub.app)は自動アクセスを丸ごと拒否するので使えない。
# 未設定でも収集は止まらない。Reddit だけが動き、他は見送りとして記録される。
RSSHUB_BASE_URL=

# RSSHub 側に ACCESS_KEY を設定した場合のみ、同じ値を入れる。
# URL が漏れても他人に叩かれないようにするための鍵。未設定でも動く。
RSSHUB_ACCESS_KEY=


# Notion。動画DBと企画DBの2つを使う
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_INTELLIGENCE_DB_ID=

# 監視対象チャンネルをNotion側で管理する場合のDB。未設定でも動く
NOTION_CHANNELS_DB_ID=

# 実行ログをNotionにも残す場合のDB。未設定でも動く
NOTION_LOG_DB_ID=

# Gemini。トピックの要約に使う。未設定なら要約なしで動く
GEMINI_API_KEY=


# ---- 通知 ----

# 収集結果の定期通知
DISCORD_WEBHOOK_URL=

# 異常時の警告通知。DISCORD_ALERT_ENABLED=true で有効になる
DISCORD_ALERT_WEBHOOK_URL=
DISCORD_ALERT_ENABLED=


# ---- Webアプリ (Vercel) ----

# GitHub Actions を画面から起動するためのトークン
GITHUB_TOKEN=

# APIの簡易認証。未設定だと公開URLから誰でも書き込める点に注意。
# 設定する場合は、外部cronのURLにも ?key= を付け足すこと。付け忘れると収集が止まる
APP_SECRET=
