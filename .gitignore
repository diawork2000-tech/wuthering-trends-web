# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.pyc

# ローカル作業用の一時ファイル・デバッグ出力（誤コミット防止）
/action_log.txt
/logs.zip
/logs/
/test.js
/scraper/test_trans.py
/scraper/trends_output.json
/scraper/video_list.md

# 削除スクリプトの実行ログ（実行のたびに変わる作業ファイル）
scraper/purge_run.log

# 自動生成のバックアップ（write_json_atomic が作る1世代前の控え）
*.json.bak
*.json.tmp
scraper/purge_ads_audit.log
